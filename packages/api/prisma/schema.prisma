generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.VarChar(255)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  displayName     String?      @map("display_name") @db.VarChar(100)
  avatarUrl       String?      @map("avatar_url") @db.Text
  authProvider    AuthProvider @default(LOCAL) @map("auth_provider")
  oauthProviderId String?      @map("oauth_provider_id") @db.VarChar(255)
  isAdmin             Boolean      @default(false) @map("is_admin")
  mustChangePassword  Boolean      @default(false) @map("must_change_password")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  profile          UserProfile?
  settings         UserSettings?
  foodLogs         FoodLog[]
  macroPlans       MacroPlan[]
  mealPlans        MealPlan[]
  passkeys         Passkey[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]

  @@map("users")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
  SAML
  OIDC
  PASSKEY
}

model UserProfile {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  heightCm       Float?         @map("height_cm")
  weightKg       Float?         @map("weight_kg")
  age            Int?
  birthDate      DateTime?      @map("birth_date") @db.Date
  sex            Sex?
  activityLevel  ActivityLevel? @map("activity_level")
  goal           Goal?
  targetCalories Int?           @map("target_calories")
  targetProteinG Int?           @map("target_protein_g")
  targetCarbsG   Int?           @map("target_carbs_g")
  targetFatG     Int?           @map("target_fat_g")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
}

model UserSettings {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @unique @map("user_id") @db.Uuid
  openaiApiKey    String?    @map("openai_api_key") @db.Text
  anthropicApiKey String?    @map("anthropic_api_key") @db.Text
  geminiApiKey    String?    @map("gemini_api_key") @db.Text
  aiProvider      AiProvider @default(OPENAI) @map("ai_provider")
  preferredUnits  Units      @default(METRIC) @map("preferred_units")
  darkMode        Boolean    @default(false) @map("dark_mode")
  timezone        String?    @db.VarChar(100)
  location        String?    @db.VarChar(255)
  mealieUrl       String?    @map("mealie_url") @db.Text
  mealieApiKey    String?    @map("mealie_api_key") @db.Text
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum Units {
  METRIC
  IMPERIAL
}

// ─── Passkeys (WebAuthn) ─────────────────────────────────────────

model Passkey {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  credentialId      String   @unique @map("credential_id") @db.Text
  publicKey         String   @map("public_key") @db.Text
  counter           BigInt   @default(0)
  transports        String[] @default([])
  deviceType        String?  @map("device_type") @db.VarChar(50)
  backedUp          Boolean  @default(false) @map("backed_up")
  friendlyName      String?  @map("friendly_name") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// ─── Body Measurements ──────────────────────────────────────────

model BodyMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  measuredAt DateTime @map("measured_at") @db.Date
  waist      Float?
  hip        Float?
  abdomen    Float?
  chest      Float?
  thighR     Float?   @map("thigh_r")
  thighL     Float?   @map("thigh_l")
  bicepR     Float?   @map("bicep_r")
  bicepL     Float?   @map("bicep_l")
  neck       Float?
  calfR      Float?   @map("calf_r")
  calfL      Float?   @map("calf_l")
  shoulder   Float?
  weightKg   Float?   @map("weight_kg")
  bodyFatPct Float?   @map("body_fat_pct")
  leanMassKg Float?   @map("lean_mass_kg")
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@map("body_measurements")
}

// ─── Progress Photos ────────────────────────────────────────────

model ProgressPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  filePath  String   @map("file_path") @db.Text
  takenAt   DateTime @map("taken_at") @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
  @@map("progress_photos")
}

// ─── Food Items ──────────────────────────────────────────────────

model FoodItem {
  id              String     @id @default(uuid()) @db.Uuid
  barcode         String?    @unique @db.VarChar(50)
  name            String     @db.VarChar(255)
  brand           String?    @db.VarChar(255)
  servingSizeG    Float      @map("serving_size_g")
  servingUnit     String     @default("g") @map("serving_unit") @db.VarChar(20)
  caloriesPer100g Float      @map("calories_per_100g")
  proteinPer100g  Float      @map("protein_per_100g")
  carbsPer100g    Float      @map("carbs_per_100g")
  fatPer100g      Float      @map("fat_per_100g")
  fiberPer100g    Float?     @map("fiber_per_100g")
  sugarPer100g    Float?     @map("sugar_per_100g")
  sodiumPer100g   Float?     @map("sodium_per_100g")
  imageUrl        String?    @map("image_url") @db.Text
  source          FoodSource @default(OPENFOODFACTS)
  offProductJson  Json?      @map("off_product_json")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  foodLogs FoodLog[]

  @@index([barcode])
  @@index([name])
  @@map("food_items")
}

enum FoodSource {
  OPENFOODFACTS
  MANUAL
  LABEL_SCAN
  AI_ESTIMATE
  USDA
}

// ─── Food Log ────────────────────────────────────────────────────

model FoodLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  foodItemId    String   @map("food_item_id") @db.Uuid
  logDate       DateTime @map("log_date") @db.Date
  mealType      MealType @map("meal_type")
  servingQty    Float    @map("serving_qty")
  servingSizeG  Float    @map("serving_size_g")
  totalCalories Float    @map("total_calories")
  totalProteinG Float    @map("total_protein_g")
  totalCarbsG   Float    @map("total_carbs_g")
  totalFatG     Float    @map("total_fat_g")
  totalFiberG   Float?   @map("total_fiber_g")
  totalSugarG   Float?   @map("total_sugar_g")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@index([userId, logDate])
  @@index([logDate])
  @@map("food_logs")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// ─── AI Macro Plans ──────────────────────────────────────────────

model MacroPlan {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(255)
  goal           Goal
  targetCalories Int      @map("target_calories")
  targetProteinG Int      @map("target_protein_g")
  targetCarbsG   Int      @map("target_carbs_g")
  targetFatG     Int      @map("target_fat_g")
  reasoning      String   @db.Text
  inputSnapshot  Json     @map("input_snapshot")
  aiModel        String   @map("ai_model") @db.VarChar(50)
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("macro_plans")
}

// ─── SSO Providers ──────────────────────────────────────────────

model SsoProvider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  type      SsoType
  config    Json
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sso_providers")
}

enum SsoType {
  SAML
  OIDC
}

// ─── App Configuration ──────────────────────────────────────────

model AppConfig {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

// ─── AI Meal Plans ───────────────────────────────────────────────

model MealPlan {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(255)
  durationDays   Int      @map("duration_days")
  targetCalories Int      @map("target_calories")
  targetProteinG Int      @map("target_protein_g")
  targetCarbsG   Int      @map("target_carbs_g")
  targetFatG     Int      @map("target_fat_g")
  planData       Json     @map("plan_data")
  preferences    Json?
  aiModel        String   @map("ai_model") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("meal_plans")
}
