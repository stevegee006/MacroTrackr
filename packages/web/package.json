{
  "name": "@macrotracker/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "pnpm --filter @macrotracker/shared build && pnpm --filter @macrotracker/healthkit build && cross-env NEXT_MOBILE=1 NEXT_PUBLIC_API_URL=https://macros-api.geehive.com/api/v1 next build",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "pnpm build:mobile && node scripts/generate-brand-assets.mjs && node scripts/ios-configure.mjs && cap sync ios && capacitor-assets generate --ios --assetPath assets",
    "cap:open": "cap open ios",
    "cap:run": "cap run ios --livereload --external"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "~7.5.0",
    "@capacitor/app": "^8",
    "@capacitor/core": "^8",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8",
    "@macrotracker/healthkit": "workspace:*",
    "@macrotracker/shared": "workspace:*",
    "@serwist/next": "^9.5.7",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5",
    "clsx": "^2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.475",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3.24",
    "zustand": "^5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8",
    "@capacitor/ios": "^8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7",
    "serwist": "^9.5.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5.7"
  }
}
